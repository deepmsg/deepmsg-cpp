#!/usr/bin/env bash
# `JAVA_EXECUTABLE` for the reference C archive suite.
#
# The pinned `TestArchive.h` spawns the archive with
# `posix_spawn(..., envp = NULL)`, which gives the child an **empty
# environment** — an environment-driven shim (test/interop/shim/java) cannot be
# switched to mapped mode from the caller. This wrapper decides from argv
# instead: the archive main class goes to our binary, every other invocation
# (`-version` during CMake configure, unrelated main classes) goes to the real
# JVM.
#
# The binary directory comes from `mapped.conf` next to this script when it
# exists (written by the test runner), then `AXC_BIN_DIR`, then the debug
# preset default.

set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
conf="$here/mapped.conf"
if [ -f "$conf" ]; then
    # shellcheck disable=SC1090
    . "$conf"
fi

bin_dir=${AXC_BIN_DIR:-"$here/../../../build/debug/apps/deepmsg-archive-server"}
real_java=${AXC_REAL_JAVA:-/usr/bin/java}

for argument in "$@"; do
    if [ "$argument" = "io.aeron.archive.ArchivingMediaDriver" ]; then
        exec "$bin_dir/deepmsg-archive-server" "$@"
    fi
done

exec "$real_java" "$@"
