# SBE ids and tokens for the archive and cluster codecs. Template ids are the
# generated `SBE_TEMPLATE_ID` values, written little-endian.
#
# Schema ids: 100 archive-mark, 101 archive, 111 cluster, 112 cluster-mark.
schema_archive_mark="\x64\x00"
schema_archive="\x65\x00"
schema_cluster="\x6f\x00"
schema_cluster_mark="\x70\x00"

# Archive templates.
archive_close_session="\x03\x00"
archive_start_recording="\x04\x00"
archive_stop_recording="\x05\x00"
archive_replay="\x06\x00"
archive_stop_replay="\x07\x00"
archive_list_recordings="\x08\x00"
archive_list_recordings_for_uri="\x09\x00"
archive_truncate_recording="\x0d\x00"
archive_bounded_replay="\x12\x00"
archive_stop_all_replays="\x13\x00"
archive_stop_replication="\x33\x00"
archive_detach_segments="\x35\x00"
archive_migrate_segments="\x39\x00"
archive_auth_connect="\x3a\x00"
archive_challenge_response="\x3c\x00"
archive_keep_alive="\x3d\x00"
archive_start_recording_2="\x3f\x00"
archive_replicate_2="\x42\x00"
archive_id_request="\x44\x00"
archive_purge_recording="\x68\x00"
archive_replay_token="\x69\x00"
archive_update_channel="\x6b\x00"

# Cluster templates.
cluster_session_message_header="\x01\x00"
cluster_session_event="\x02\x00"
cluster_session_connect="\x03\x00"
cluster_session_close="\x04\x00"
cluster_session_keep_alive="\x05\x00"
cluster_new_leader_event="\x06\x00"
cluster_challenge="\x07\x00"
cluster_challenge_response="\x08\x00"
cluster_admin_request="\x1a\x00"
cluster_schedule_timer="\x1f\x00"
cluster_cancel_timer="\x20\x00"
cluster_service_ack="\x21\x00"
cluster_cluster_members_query="\x22\x00"
cluster_join_log="\x28\x00"
cluster_service_termination_position="\x2a\x00"
cluster_canvass_position="\x32\x00"
cluster_request_vote="\x33\x00"
cluster_vote="\x34\x00"
cluster_new_leadership_term="\x35\x00"
cluster_append_position="\x36\x00"
cluster_commit_position="\x37\x00"
cluster_catchup_position="\x38\x00"
cluster_stop_catchup="\x39\x00"
cluster_backup_query="\x4d\x00"
cluster_snapshot_marker="\x64\x00"
cluster_session="\x67\x00"
cluster_timer="\x68\x00"
cluster_consensus_module="\x69\x00"
cluster_pending_message_tracker="\x6b\x00"
cluster_request_service_ack="\x6c\x00"

# Channel URI tokens.
uri_ipc="aeron:ipc"
uri_udp="aeron:udp?endpoint=localhost:9000"
uri_nested="aeron:udp?endpoint=localhost:9000|term-length=64k|sparse=true"
checksum_crc32="io.aeron.archive.checksum.Crc32"
checksum_crc32c="io.aeron.archive.checksum.Crc32c"

# Ethernet / ARP / IPv4 ethertypes (big-endian).
eth_ipv4="\x08\x00"
eth_arp="\x08\x06"
