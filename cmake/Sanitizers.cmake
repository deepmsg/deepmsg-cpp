# AXC_SANITIZER = address | thread | undefined | (empty)
function(axc_apply_sanitizer target)
    if (NOT AXC_SANITIZER)
        return()
    endif ()

    if (AXC_SANITIZER STREQUAL "address")
        set(flags -fsanitize=address -fno-omit-frame-pointer)
    elseif (AXC_SANITIZER STREQUAL "thread")
        set(flags -fsanitize=thread -fno-omit-frame-pointer)
    elseif (AXC_SANITIZER STREQUAL "undefined")
        set(flags -fsanitize=undefined -fno-omit-frame-pointer)
    else ()
        message(FATAL_ERROR "AXC_SANITIZER='${AXC_SANITIZER}' is not one of address|thread|undefined")
    endif ()

    target_compile_options(${target} PRIVATE ${flags})
    target_link_options(${target} PRIVATE ${flags})
endfunction()
